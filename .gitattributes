# Line endings: LF everywhere (matches .editorconfig), independent of each clone's core.autocrlf
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

