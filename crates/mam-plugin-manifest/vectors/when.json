{
  "version": 1,
  "identifiers": {
    "selection.count": "number",
    "asset.kind": { "enum": ["image", "video", "audio"] },
    "asset.offline": "bool"
  },
  "cases": [
    { "id": "W-001", "expr": "asset.kind == 'video'", "context": { "asset.kind": "video" }, "expect": true },
    { "id": "W-002", "expr": "asset.kind == 'video'", "context": { "asset.kind": "image" }, "expect": false },
    { "id": "W-003", "expr": "asset.kind == \"image\"", "context": { "asset.kind": "image" }, "expect": true },
    { "id": "W-004", "expr": "asset.kind != 'video'", "context": { "asset.kind": "image" }, "expect": true },
    { "id": "W-005", "expr": "asset.offline", "context": { "asset.offline": true }, "expect": true },
    { "id": "W-006", "expr": "asset.offline", "context": { "asset.offline": false }, "expect": false },
    { "id": "W-007", "expr": "!asset.offline", "context": { "asset.offline": false }, "expect": true },
    { "id": "W-008", "expr": "!asset.offline", "context": {}, "expect": true },
    { "id": "W-009", "expr": "asset.offline", "context": {}, "expect": false },
    { "id": "W-010", "expr": "selection.count >= 1", "context": { "selection.count": 1 }, "expect": true },
    { "id": "W-011", "expr": "selection.count > 1", "context": { "selection.count": 1 }, "expect": false },
    { "id": "W-012", "expr": "selection.count < 2", "context": { "selection.count": 1 }, "expect": true },
    { "id": "W-013", "expr": "selection.count <= 1", "context": { "selection.count": 1 }, "expect": true },
    { "id": "W-014", "expr": "selection.count == 1", "context": { "selection.count": 1 }, "expect": true },
    { "id": "W-015", "expr": "selection.count != 1", "context": { "selection.count": 2 }, "expect": true },
    { "id": "W-016", "expr": "selection.count >= 1", "context": {}, "expect": false },
    { "id": "W-017", "expr": "selection.count == 1", "context": {}, "expect": false },
    { "id": "W-018", "expr": "selection.count != 1", "context": {}, "expect": true },
    { "id": "W-019", "expr": "true || false && false", "context": {}, "expect": true },
    { "id": "W-020", "expr": "asset.kind < 'v'", "context": {}, "expect": { "error": "typeMismatch" } },
    { "id": "W-021", "expr": "(true || false) && false", "context": {}, "expect": false },
    { "id": "W-022", "expr": "!false && false", "context": {}, "expect": false },
    { "id": "W-023", "expr": "asset.offline && asset.kind == 'image'", "context": { "asset.offline": false, "asset.kind": 5 }, "expect": false },
    { "id": "W-024", "expr": "asset.offline || asset.kind == 'image'", "context": { "asset.offline": true, "asset.kind": 5 }, "expect": true },
    { "id": "W-025", "expr": "asset.kind == 'image' && asset.offline", "context": { "asset.offline": true, "asset.kind": 5 }, "expect": false },
    { "id": "W-026", "expr": "selection.count == -1", "context": { "selection.count": -1 }, "expect": true },
    { "id": "W-027", "expr": "selection.count > 0.5", "context": { "selection.count": 1 }, "expect": true },
    { "id": "W-028", "expr": "selection.count == 1.5", "context": { "selection.count": 1.5 }, "expect": true },
    { "id": "W-029", "expr": "selection.count == 01", "context": {}, "expect": { "error": "syntax" } },
    { "id": "W-030", "expr": "asset.offline", "context": { "asset.offline": "yes" }, "expect": false },
    { "id": "W-031", "expr": "selection.count == 1.", "context": {}, "expect": { "error": "syntax" } },
    { "id": "W-032", "expr": "asset.kind = 'image'", "context": {}, "expect": { "error": "syntax" } },
    { "id": "W-033", "expr": "asset.offline & true", "context": {}, "expect": { "error": "syntax" } },
    { "id": "W-034", "expr": "asset.offline | true", "context": {}, "expect": { "error": "syntax" } },
    { "id": "W-035", "expr": "selection.count < 1 < 2", "context": {}, "expect": { "error": "syntax" } },
    { "id": "W-036", "expr": "foo.bar == 1", "context": {}, "expect": { "error": "unknownIdentifier" } },
    { "id": "W-037", "expr": "asset.kind == 'movie'", "context": {}, "expect": { "error": "typeMismatch" } },
    { "id": "W-038", "expr": "selection.count == 'a'", "context": {}, "expect": { "error": "typeMismatch" } },
    { "id": "W-039", "expr": "selection.count", "context": {}, "expect": { "error": "typeMismatch" } },
    { "id": "W-040", "expr": "!selection.count", "context": {}, "expect": { "error": "typeMismatch" } },
    { "id": "W-041", "expr": "selection.count && true", "context": {}, "expect": { "error": "typeMismatch" } },
    { "id": "W-042", "expr": "'a' == 'a'", "context": {}, "expect": true },
    { "id": "W-043", "expr": "'a' == \"a\"", "context": {}, "expect": true },
    { "id": "W-044", "expr": "1 < 2", "context": {}, "expect": true },
    { "id": "W-045", "expr": "true == true", "context": {}, "expect": true },
    { "id": "W-046", "expr": "'a\\\\'b' == \"a'b\"", "context": {}, "expect": { "error": "syntax" } },
    { "id": "W-047", "expr": "'a\\'b' == \"a'b\"", "context": {}, "expect": true },
    { "id": "W-048", "expr": "'a\\\\b' == \"a\\\\b\"", "context": {}, "expect": true },
    { "id": "W-049", "expr": "'a\\n' == 'a'", "context": {}, "expect": { "error": "syntax" } },
    { "id": "W-050", "expr": "'abc == 1", "context": {}, "expect": { "error": "syntax" } },
    { "id": "W-051", "expr": "asset.kind == 'video' && !asset.offline && selection.count >= 1", "context": { "asset.kind": "video", "asset.offline": false, "selection.count": 3 }, "expect": true },
    { "id": "W-052", "expr": "", "context": {}, "expect": { "error": "syntax" } },
    { "id": "W-053", "expr": "   ", "context": {}, "expect": { "error": "syntax" } },
    { "id": "W-054", "expr": "selection.count == 1 )", "context": {}, "expect": { "error": "syntax" } },
    { "id": "W-055", "expr": "(selection.count == 1", "context": {}, "expect": { "error": "syntax" } },
    { "id": "W-056", "expr": "asset.offline == true", "context": { "asset.offline": true }, "expect": true },
    { "id": "W-057", "expr": "asset.offline == false", "context": {}, "expect": false },
    { "id": "W-058", "expr": "'한글' == \"한글\"", "context": {}, "expect": true },
    { "id": "W-059", "expr": "  asset.kind\t==\n'image'\r", "context": { "asset.kind": "image" }, "expect": true },
    { "id": "W-060", "expr": "selection.count == 1 && ", "context": {}, "expect": { "error": "syntax" } },
    { "id": "W-061", "expr": "selection.count >= 1 && selection.count <= 3", "context": { "selection.count": 2 }, "expect": true },
    { "id": "W-062", "expr": "asset.kind == asset.kind", "context": { "asset.kind": "audio" }, "expect": true },
    { "id": "W-063", "expr": "selection.count == null", "context": {}, "expect": { "error": "unknownIdentifier" } },
    { "id": "W-064", "expr": "true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true", "context": {}, "expect": true },
    { "id": "W-065", "expr": "true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true&&true ", "context": {}, "expect": { "error": "tooLong" } },
    { "id": "W-066", "expr": "((((((((((((((((true))))))))))))))))", "context": {}, "expect": true },
    { "id": "W-067", "expr": "(((((((((((((((((true)))))))))))))))))", "context": {}, "expect": { "error": "tooDeep" } },
    { "id": "W-068", "expr": "!!!!!!!!!!!!!!!!true", "context": {}, "expect": true },
    { "id": "W-069", "expr": "!!!!!!!!!!!!!!!!!true", "context": {}, "expect": { "error": "tooDeep" } }
  ]
}
