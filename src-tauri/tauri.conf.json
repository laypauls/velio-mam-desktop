{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "velio",
  "mainBinaryName": "velio",
  "version": "0.1.1",
  "identifier": "com.mam.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "velio.",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://mamthumb.localhost mamthumb: http://mammedia.localhost mammedia:; media-src 'self' http://mammedia.localhost mammedia:; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": "default-src 'self'; img-src 'self' data: http://mamthumb.localhost mamthumb: http://mammedia.localhost mammedia:; media-src 'self' http://mammedia.localhost mammedia:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md",
      "locales/*.json": "locales/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxNUU0MkY2MzFCNzgzNkMKUldSc2c3Y3g5a0pla1krYjBIKzFiOS9lL1BkN2pMTE10a1UrdVZwQUhHZFJtQnAwUUcwa0hhK2UK",
      "endpoints": ["https://updates.example.invalid/mam-desktop/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
